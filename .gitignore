# VERIDEX .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store

# Environment variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.key
**/config.json
**/secrets.json
**/*_config.py
**/*_secret.py

# Data & Logs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
logs/
*.log
*.log.*

# Model checkpoints
models/checkpoints/
*.ckpt
*.pth
*.pt

# Reports & Outputs
reports/
outputs/
results/*
!results/README.md
!results/*/README.md
*.csv
*.xlsx
!data/benchmarks/*.csv

# Figures (generated)
figures/*.png
figures/*.jpg
figures/*.pdf
!figures/README.md

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.sqlite
*.db

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
*~

# API Keys & Secrets (NEVER COMMIT)
**/api_keys.json
**/secrets.yaml
**/*_secret.py

# Large files (archives)
*.gz
*.zip
*.tar
*.7z
*.dump
dump.rdb

# ═══════════════════════════════════════════════════════════════════
# VERIDEX SPECIFIC - LARGE FILES (DO NOT PUSH TO GITHUB)
# ═══════════════════════════════════════════════════════════════════

# Dataset files (excluded for publication - see DATA_ACQUISITION.md)
data/*.json
data/dataset/*.json
data/large_dataset/*.json
!data/rating_systems/*.json

# Image files (322 MB+)
data/images/
data/images_48k/
data/*.zip
*.zip

# Evaluation reports
data/evaluation/*.json
data/demo_results/

# Old checkpoints
data/dataset/checkpoint*.json

# Verification/audit reports (optional, can be regenerated)
VERIFICATION_REPORT.md
FINAL_FILES_LIST.md

# Documentation build
docs/_build/
site/

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Neo4j
neo4j_data/

# Vector DB
weaviate_data/
chroma_data/

